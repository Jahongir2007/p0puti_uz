        {
          "name": "Login with forged initData is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/telegram",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "telegram"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initData\": \"auth_date=1&user=%7B%22id%22%3A1%7D&hash=00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.expect(pm.response.code).to.eql(401));",
                  "pm.test('Says the signature is invalid', () => pm.expect(pm.response.json().message).to.eql('Invalid Telegram initData'));"
                ]
              }
