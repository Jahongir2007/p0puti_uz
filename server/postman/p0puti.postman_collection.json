          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ads are saved by the worker in the background: give it a moment.",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const tashkentDay = (iso) => new Date(new Date(iso).getTime() + 5 * 3600 * 1000).toISOString().slice(0, 10);",
                  "const onDay = pm.response.json().data.filter((a) => tashkentDay(a.departureTime) === pm.environment.get('adDate'));",
                  "pm.test('Both new ads were saved by the worker', () => pm.expect(onDay.map((a) => a.type)).to.include.members(['DRIVER', 'PASSENGER']));",
                  "const driver = onDay.find((a) => a.type === 'DRIVER');",
                  "if (driver) pm.environment.set('adId', driver.id);"
                ]
              }
            }
          ]
